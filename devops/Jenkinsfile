def runInDocker(String image, String args = '', Closure body) {
    body.resolveStrategy = Closure.DELEGATE_FIRST
    docker.image(image).inside(args) {
        body()
    }
}

pipeline {
  // `agent any` = el pipeline se ejecuta en cualquier nodo/agente disponible.
  agent any
  
  /*agent {
    docker {
      image 'maven:3.8.6-openjdk-11-slim'
      args '-u root'
    }
  }*/  

  stages {
    /**stage('Info') {
      steps {
        echo "Job: ${env.JOB_NAME}"
        echo "Build: ${env.BUILD_NUMBER}"
        echo "Branch: ${env.BRANCH_NAME}"
      }
    }
    
    stage('Test') {
      steps {
        sh 'mvn -version'
        sh 'mvn test'
      }
    }*/
    stage('Prepare') {
        steps {
            // Las imágenes slim de Java tampoco suelen traer 'make'
            sh 'apt-get update && apt-get install -y make'
        }
    }
    stage('CI - Lint') {
      steps {
        // Actualizamos e instalamos make
         runInDocker('maven:3.8.6-openjdk-11-slim', '-u root') {
            sh 'make lint'
         }
      }
    }
    /*stage('CI - Test') {
