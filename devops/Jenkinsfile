//método para la ejecución de tareas en una imágen en docker
/*def runInDocker(String image, Closure body) {
   docker.image(image).inside { body() }
}*/

//llamada a la librería que se encunetra en el repo devops-training-iac-devops y que ha sido configurado 
// en el jenkinsFile
@Library('iac-devops-lib') _
pipeline {
  // `agent any` = el pipeline se ejecuta en cualquier nodo/agente disponible.
  agent any

  // Definición de parámetros
  parameters {
   // parámetro concicional que haremos uso en el stage CD para ejecutar o no dicho stage
    booleanParam(name: 'RUN_CD', defaultValue: false, description: 'Ejecutar CD') 
  }   

  //variables de entorno
  environment {
     MVN_IMAGE =  'maven:3.9.6-eclipse-temurin-17'
     IMAGE_REPO_LOCAL = 'devops_training-java-app'
     COMPOSE_FILE = 'docker-compose.yml'
     SERVICE_NAME = 'app'
  }

  stages {
     // con este stage mostraremos en el log el nombre del job, la versión al construir y la rama donde se ejecuta
     // el pipeline
     stage('Info') {
        steps {
          echo "Job: ${env.JOB_NAME}"
          echo "Build: ${env.BUILD_NUMBER}"
          echo "Branch: ${env.BRANCH_NAME}"
        }
     }

     //stage donde se defien de inicio la versión de la imágen, la versión del .jar y la imagen local
     stage('Versioning') {
      steps {
        script {
           env.IMAGE_VERSION = devopsLib.readVersion('VERSION')
           env.VERSION_JAR = "${env.IMAGE_VERSION}-SNAPSHOT"
           env.IMAGE_LOCAL = "${env.IMAGE_REPO_LOCAL}:${env.IMAGE_VERSION}"
        }
      }
    }

   // stage con el que se lanzará los test usando la imágen definida de maven, mediante el uso de la librería 
   // del proyecto configudarada en jenkinsFile
    stage('Test') {
      steps {
        script {
           devopsLib.runInDocker(env.MVN_IMAGE) {
             sh 'mvn -version'
             sh 'mvn test'
           }
        }   
      }
    }

   // stage en el que se crea make lint
    stage('CI - Lint') {
      steps {
         script {
            devopsLib.runInDocker(env.MVN_IMAGE) { 
               sh 'apt-get update && apt-get install -y make'
               sh 'make lint'
            }
         }   
      }
    }
    // stage en el que se ejecutan los test 
    stage('CI - Test') {
      steps {
         script {
            devopsLib.runInDocker(env.MVN_IMAGE) { 
               sh 'apt-get update && apt-get install -y make' 
               sh 'make test'
            }  
         }  
      }
    }

   // stage para crear la imágen mediante el uso de docker pasando como parámetros definidos
    stage('CI - Build image') {
      steps {
        script {
          docker.build(env.IMAGE_LOCAL, "--build-arg VERSION=${env.VERSION_JAR} -f devops/Dockerfile .") 
        }
      }
    }

   // stage para la fase del despliegue continuo
    stage('CD') {
        when {
          allOf {
            anyOf {
              // ramas permitidas para el CD
              branch 'develop'
              branch 'main'
            }
            // se mostrará en el pipeline de jenkins la posibilidad de hacer o no el stage de CD
            expression { return params.RUN_CD }
          }
        }
        steps {
          script {
            // una vez habilitado RUN_CD se ejecuta el scrip de la rama donde se lanza en pipeline
            echo "CD habilitado: RUN_CD=${params.RUN_CD}, branch=${env.BRANCH_NAME}"  
            env.DEPLOY_ENV = (env.BRANCH_NAME == 'main') ? 'PRO' : 'DEV'
            echo "Deploy env: ${env.DEPLOY_ENV}"

            //seteo de la imagen mediante el uso del método de la librería devopsLib
            devopsLib.setComposeServiceImage(
               composeFile: env.COMPOSE_FILE, // Opcional, por defecto "docker-compose.yml"
               serviceName: env.SERVICE_NAME, // Opcional, por defecto "app"
               image: env.IMAGE_LOCAL   // Obligatorio
            )
            // comentado porque se pasa a usar el método composeUpTestDown de la librería devopsLib   
            /*try {
              sh 'docker compose up -d'
              sh 'sleep 5'
              sh 'docker compose logs app'
            } finally {
              sh 'docker compose down --volumes'
            }*/
            devopsLib.composeUpTestDown(
               up:   'docker compose up -d',
               test: 'docker compose logs app', // Aquí tus tests o validaciones de CD
               down: 'docker compose down --volumes'
            ) 
          }
        }
        // tras la ejecución se lanza el método post para mostrar si el proceso ha ido correcto o ha fallado
        post {
          always {
            echo "Cleanup done"
          }
          success { echo 'SUCCESS' }
          failure { 
             echo 'FAILURE' 
             sh 'docker compose logs || true'
          }
        }
      }
  }
}
